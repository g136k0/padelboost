# Set these locally in .env.local, and in Vercel > Settings > Environment Variables.
# Never commit real Stripe secrets.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=
# Show a small preview notice until the product and policies have been verified.
NEXT_PUBLIC_STORE_MODE=preview

# Checkout is deliberately OFF until you supply verified operational details.
CHECKOUT_ENABLED=false
STRIPE_SECRET_KEY=
# Create a Shipping Rate in Stripe Dashboard (a single EU flat rate for this MVP).
STRIPE_SHIPPING_RATE_ID=
# Optional: only enable after configuring your Stripe Tax registrations.
STRIPE_AUTOMATIC_TAX_ENABLED=false
