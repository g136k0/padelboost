# Set these locally in .env.local, and in Vercel > Settings > Environment Variables.
# Never commit real Stripe secrets.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=
# Show a small preview notice until the product and policies have been verified.
NEXT_PUBLIC_STORE_MODE=preview

# Checkout is deliberately OFF until you supply verified operational details.
CHECKOUT_ENABLED=false
STRIPE_SECRET_KEY=
# Create a Shipping Rate in Stripe Dashboard (a single EU flat rate for this MVP).
STRIPE_SHIPPING_RATE_ID=
# Required when enabling Checkout: create two active one-time EUR, tax-inclusive
# Prices in Stripe Dashboard, for €24.90 and €39.90 respectively.
# Assign each Product its appropriate PHYSICAL GOODS tax code in Stripe.
STRIPE_PRICE_SINGLE=
STRIPE_PRICE_DOUBLE=
# Optional: only enable after configuring your Stripe Tax registrations.
STRIPE_AUTOMATIC_TAX_ENABLED=false

# PRIVATE ADMIN PANEL /admin — use two different random values.
# Each value can be generated by running:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Keep these SERVER-ONLY: never prefix them with NEXT_PUBLIC_.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Use the same Stripe key as checkout. In test mode, /admin displays test orders.
# Enable Vercel WAF rate limiting on /admin login before handling real customer data.
